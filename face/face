#!/usr/bin/env python3
"""Send an expression or spoken line to this folder's Television face."""

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
import time
import uuid


FOLDER = Path(__file__).resolve().parent
MOODS = (
    "neutral", "happy", "smug", "thinking", "surprised", "confused",
    "sad", "sleepy", "mischievous",
)
AUDIO_PART = re.compile(r"[A-Za-z0-9._-]+\Z")


def tv(*arguments: str) -> str:
    """Run one Television command and give CLI failures a readable message."""
    result = subprocess.run(["tv", *arguments], capture_output=True, text=True, check=False)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "tv command failed")
    return result.stdout.strip()


def artifact_id() -> str:
    """Find the single path artifact pointing at this script's folder."""
    response = json.loads(tv("list-artifacts"))
    matches = [
        artifact for artifact in response.get("artifacts", [])
        if artifact.get("kind") == "path"
        and Path(artifact.get("path", "")).resolve() == FOLDER
    ]
    if len(matches) == 1:
        return matches[0]["id"]
    if matches:
        raise RuntimeError(f"Several Television artifacts point at {FOLDER}; keep one for this demo.")
    raise RuntimeError(
        f"No Television path artifact points at {FOLDER}. "
        "Register it with tv create-path-artifact --path <folder> first."
    )


def audio_path(filename: str) -> str:
    """Accept only a regular audio file below this folder, never a URL or escape."""
    parts = filename.split("/")
    if (
        not parts or any(part in ("", ".", "..") or not AUDIO_PART.fullmatch(part) for part in parts)
        or Path(parts[-1]).suffix.lower() not in (".wav", ".mp3", ".m4a", ".ogg")
    ):
        raise ValueError("--audio must name a .wav, .mp3, .m4a or .ogg file inside this folder")
    path = FOLDER.joinpath(*parts)
    if not path.is_file() or not path.resolve().is_relative_to(FOLDER):
        raise ValueError(f"Audio file does not exist inside {FOLDER}: {filename}")
    return filename


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    """Parse the three small commands the on-stage agent uses."""
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    speak = commands.add_parser("say", help="Speak a new line once")
    speak.add_argument("text")
    speak.add_argument("--mood", choices=MOODS, help="Expression during this line")
    speak.add_argument("--audio", help="Audio file inside this folder, instead of browser speech")
    rest = commands.add_parser("mood", help="Set the resting expression")
    rest.add_argument("mood", choices=MOODS)
    commands.add_parser("reset", help="Return to neutral and clear the line")
    return parser.parse_args(argv)


def store_update(arguments: argparse.Namespace) -> dict:
    """Build the complete atomic update without reading the current store."""
    if arguments.command == "reset":
        return {"mood": "neutral", "say": None}
    if arguments.command == "mood":
        return {"mood": arguments.mood}
    if not arguments.text.strip():
        raise ValueError("Say text cannot be empty")
    line = {
        "id": uuid.uuid4().hex,
        "text": arguments.text,
        "at": int(time.time() * 1000),
    }
    if arguments.mood:
        line["mood"] = arguments.mood
    if arguments.audio:
        line["audio"] = audio_path(arguments.audio)
    return {"say": line}


def main() -> int:
    """Resolve the artifact and make exactly one JSON store write."""
    arguments = parse_arguments(sys.argv[1:])
    try:
        update = store_update(arguments)
        identifier = artifact_id()
        tv("resource", "json", "update", "--artifact", identifier, json.dumps(update))
    except (OSError, ValueError, KeyError, json.JSONDecodeError, RuntimeError) as error:
        print(f"face: {error}", file=sys.stderr)
        return 1
    if arguments.command == "say":
        print("Sent the face a line.")
    elif arguments.command == "mood":
        print(f"Resting mood: {arguments.mood}.")
    else:
        print("Face reset to neutral.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
